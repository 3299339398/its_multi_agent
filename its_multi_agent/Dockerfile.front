FROM node:20-alpine AS build

ARG FRONTEND_DIR
WORKDIR /build

COPY ${FRONTEND_DIR}/package*.json ./
RUN npm ci

COPY ${FRONTEND_DIR}/ ./
RUN npm run build

FROM nginx:1.27-alpine

ARG NGINX_CONFIG
COPY ${NGINX_CONFIG} /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80
