# Docker Compose: copy to the project root .env.
# Local startup: copy applicable fields to backend/app/.env and backend/knowledge/.env.
# Fill credentials locally. Never commit .env files, model databases or encryption keys.
SF_API_KEY=
SF_BASE_URL=
MAIN_MODEL_NAME=Qwen/Qwen3-32B
AL_BAILIAN_API_KEY=
AL_BAILIAN_BASE_URL=
SUB_MODEL_NAME=qwen3-max
# Optional server-managed profiles exposed to the client. Keep API keys here only on the backend.
# MODEL_PROFILES_JSON=[{"id":"local-qwen","name":"本地 Qwen","provider":"ollama","model_name":"qwen3:14b","base_url":"http://host.docker.internal:11434/v1","api_key":"local","roles":["chat","reasoning"],"supports_tools":true,"supports_vision":false,"supports_reasoning":true,"supports_streaming":true,"context_window_tokens":32768,"max_output_tokens":4096}]
MODEL_CONTEXT_WINDOW_TOKENS_DEFAULT=32768
MODEL_MAX_OUTPUT_TOKENS_DEFAULT=4096
CONTEXT_TOKEN_SAFETY_MARGIN=1024
CONTEXT_IMAGE_TOKEN_ESTIMATE=2048
AGENT_FORK_MODE_ENABLED=true
AGENT_PARALLEL_FORK_ENABLED=true
AGENT_MAX_PARALLEL_BRANCHES=3
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
BAIDUMAP_AK=
KNOWLEDGE_BASE_URL=http://knowledge-api:8001
KNOWLEDGE_REQUEST_TIMEOUT=60
KNOWLEDGE_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=its-multi-agent
AUTH_TOKEN_TTL_MINUTES=480
AUTH_BOOTSTRAP_USERS_JSON=[{"user_id":"root1","username":"root1","password":"replace-with-a-strong-password","role":"admin"}]
USER_SQLITE_PATH=
SESSION_SQLITE_PATH=
REDIS_URL=redis://redis:6379/0
REDIS_CONTEXT_TTL=86400
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_MEMORY_COLLECTION=its_user_memories
MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
MEMORY_EMBEDDING_DIM=1024
MEMORY_EXTRACTION_MODEL=qwen3-max
MEMORY_TTL_DAYS=90
MEMORY_DEDUP_COSINE_THRESHOLD=0.88
MEMORY_RETRIEVAL_COSINE_THRESHOLD=0.3

# Optional coding-agent workspace. Keep empty to disable project modification.
CODE_WORKSPACE_ROOT=
# Only named, administrator-defined commands can run; user prompts cannot supply shell text.
# CODE_CHECK_COMMANDS_JSON={"app-tests":["backend/app/.venv/Scripts/python.exe","-m","unittest","discover","-s","backend/app/tests"],"harness-tests":["backend/app/.venv/Scripts/python.exe","-m","unittest","its_multi_agent.harness.test_harness"]}
CODE_STEP_TIMEOUT_SECONDS=180

# Knowledge service LLM and embedding configuration.
API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
BASE_URL=
MODEL=
EMBEDDING_MODEL=
MILVUS_COLLECTION=its_knowledge
PARENT_CHUNK_SIZE=2400
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=600
CHILD_CHUNK_OVERLAP=100
VECTOR_CHILD_TOP_K=15
FINAL_TOP_K=5
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_VARIANTS=2
QUERY_REWRITE_ADAPTIVE=true
QUERY_REWRITE_MIN_LENGTH=18
ADAPTIVE_REWRITE_SCORE_THRESHOLD=0.55
LEGACY_TITLE_RETRIEVAL_ENABLED=false
BM25_RETRIEVAL_ENABLED=true
BM25_TOP_K=15
BM25_MAX_QUERY_TERMS=12
RRF_K=60
SCOPE_COLLECTIONS_ENABLED=true
LEGACY_SCOPE_FALLBACK_ENABLED=true
LEGACY_SCOPE_FALLBACK_TOP_K=60
HYBRID_RERANK_ENABLED=true
RERANK_SEMANTIC_WEIGHT=0.65
RERANK_LEXICAL_WEIGHT=0.1
RERANK_QUERY_COVERAGE_WEIGHT=0.05
RERANK_RRF_WEIGHT=0.2
RERANK_SCORE_THRESHOLD=0.25
RERANK_CANDIDATE_K=20
EMBEDDING_CACHE_SIZE=512
CROSS_ENCODER_MODEL=
CROSS_ENCODER_DEVICE=cpu
OCR_ENABLED=true
OCR_PDF_TEXT_THRESHOLD=30
OCR_PDF_DPI=200
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

# MySQL container and application connection settings.
MYSQL_DATABASE=its_db
MYSQL_USER=its_app
MYSQL_PASSWORD=change-this-before-deployment
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
MYSQL_MAX_CONNECTIONS=5
