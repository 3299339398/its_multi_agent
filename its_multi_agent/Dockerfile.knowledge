FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace

WORKDIR /workspace

COPY backend/knowledge/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY . /workspace/its_multi_agent

EXPOSE 8001
CMD ["uvicorn", "its_multi_agent.backend.knowledge.api.main:create_fast_app", "--factory", "--host", "0.0.0.0", "--port", "8001"]
